            "desc": "A general-purpose kernel with no built-in bias. No innate bonuses, but the widest Trait budget for a fully custom build.",
            "trait_budget": 7,
            "effects": {}
        },
        "intrusion": {
            "id": "intrusion",
            "name": "Intrusion Architecture",
            "desc": "Routes all compute into the attack chain: intrusion strength and loot surge, at the cost of firewall and integrity.",
